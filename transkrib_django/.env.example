# Шаблон конфигурации. Скопируйте в .env и поправьте под себя:
#   cp .env.example .env

# --- Django ---
# В продакшене ОБЯЗАТЕЛЬНО замените (см. команду генерации в README):
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# DJANGO_CSRF_ORIGINS=https://transkrib.example.com

# --- Администратор (создаётся при первом старте) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Скрипт транскрибации ---
TRANSCRIBE_SCRIPT_DIR=scripts
TRANSCRIBE_SCRIPT_NAME=1.py

# --- Flask-runner (тот же контейнер) ---
RUNNER_PORT_HOST=8800
RUNNER_URL=http://127.0.0.1:8800
DJANGO_INTERNAL_BASE=http://127.0.0.1:8000
RUNNER_SECRET=dev-runner-secret-change-me

# --- Воркер / сеть ---
MAX_CONCURRENT_TASKS=1
TRANSCRIB_PORT=8000
