# ============================================================
# Транскриб · версия 2 · локальная конфигурация
# Файл подхватывается docker compose автоматически.
# В Docker-образ НЕ попадает (исключён в .dockerignore).
# ============================================================

# --- Django --------------------------------------------------
# Секретный ключ. Для продакшена обязательно сгенерируйте новый:
#   python -c "from django.core.management import utils; print(utils.get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-transkrib-local-dev-key-change-me

# Режим отладки: 1 — dev, 0 — продакшен
DJANGO_DEBUG=1

# Хосты, с которых разрешён доступ. Для локального Docker подходит *
DJANGO_ALLOWED_HOSTS=*

# Только если доступ идёт через HTTPS-прокси (nginx, Caddy и т.п.):
# DJANGO_CSRF_ORIGINS=https://transkrib.example.com

# --- Учётная запись администратора ---------------------------
# Создаётся командой seed_demo при первом старте контейнера
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Скрипт транскрибации ------------------------------------
# Каталог, в который кладётся файл скрипта (volume ./scripts:/app/scripts).
TRANSCRIBE_SCRIPT_DIR=scripts
# Имя файла скрипта внутри каталога TRANSCRIBE_SCRIPT_DIR
TRANSCRIBE_SCRIPT_NAME=1.py

# --- Flask-runner (тот же контейнер) --------------------------
# Внутренний порт runner'а (не меняйте без правки compose)
# RUNNER_PORT=8800
# Порт runner'а, пробрасываемый на хост (для отладки /health)
RUNNER_PORT_HOST=8800
# Адрес runner'а, куда Django отправляет задачи
RUNNER_URL=http://127.0.0.1:8800
# Внутренний адрес Django, куда runner шлёт результат (callback)
DJANGO_INTERNAL_BASE=http://127.0.0.1:8000
# Общий секрет для защиты callback-API (runner -> Django). Смените в проде!
RUNNER_SECRET=dev-runner-secret-change-me

# Сколько задач runner выполняет одновременно
MAX_CONCURRENT_TASKS=1

# --- Сеть -----------------------------------------------------
# Порт веб-интерфейса на хосте
TRANSCRIB_PORT=8000
