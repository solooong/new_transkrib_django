# ============================================================
# Транскриб · локальная конфигурация
# Файл подхватывается docker compose автоматически.
# В Docker-образ НЕ попадает (исключён в .dockerignore) —
# переменные прокидываются в контейнер в момент запуска.
# ============================================================

# --- Django --------------------------------------------------
# Секретный ключ. Для продакшена обязательно сгенерируйте новый:
#   python -c "from django.core.management import utils; print(utils.get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-transkrib-local-dev-key-change-me

# Режим отладки: 1 — трейсбеки и dev-раздача медиа, 0 — продакшен
DJANGO_DEBUG=1

# Хосты, с которых разрешён доступ. Для локального Docker подходит *
DJANGO_ALLOWED_HOSTS=*

# Только если доступ идёт через HTTPS-прокси (nginx, Caddy и т.п.):
# DJANGO_CSRF_ORIGINS=https://transkrib.example.com

# --- Учётная запись администратора ---------------------------
# Создаётся командой seed_demo при первом старте контейнера
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Скрипт транскрибации ------------------------------------
# Каталог, в который кладётся файл скрипта.
# Внутри контейнера это volume ./scripts:/app/scripts — файл можно
# менять на хосте без пересборки образа.
TRANSCRIBE_SCRIPT_DIR=scripts

# Имя файла скрипта внутри каталога TRANSCRIBE_SCRIPT_DIR
TRANSCRIBE_SCRIPT_NAME=1.py

# Если у вашего скрипта другой интерфейс аргументов, раскомментируйте
# и задайте команду целиком ({input} и {output} подставятся сами):
# TRANSCRIBE_CMD=python scripts/1.py {input} {output}

# --- Воркер --------------------------------------------------
# Сколько задач может выполняться одновременно (ограничено GPU/CPU)
MAX_CONCURRENT_TASKS=1

# --- Мониторинг системы --------------------------------------
# Интервал сбора метрик (psutil), секунды
METRICS_INTERVAL=2

# Сколько точек истории метрик хранить (~1,2 ч при интервале 2 с)
METRICS_KEEP=2160

# --- Сеть ----------------------------------------------------
# Порт на хосте, на котором будет доступен сервис (контейнер всегда :8000)
TRANSCRIB_PORT=8000
